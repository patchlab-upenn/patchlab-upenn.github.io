@article{bruin2024connectivity,
  title = {Connectivity as a universal predictor of tau spreading in typical and atypical Alzheimer’s disease},
  author = {Hannah de Bruin and C. Groot and H. Barthel and G. Bischof and R. Boellaard and M. Brendel and D. Cash and W. Coath and Gregory S. Day and B. Dickerson and E. Doering and A. Drzezga and Christopher H van Dyck and Thilo van Eimeren and W. M. van der Flier and Carolyn A. Fredericks and Tim D. Fryer and E. M. van de Giessen and Brian A. Gordon and J. Graff‐Radford and Diana Hobbs and G. Höglinger and M. Hönig and David J. Irwin and P. Simon Jones and K. Josephs and Yuta Katsumi and Eddie B. Lee and J. Levin and M. Malpetti and Scott M. McGinnis and A. Mecca and I. Nasrallah and John T O'Brien and Ryan S. O'Dell and Carla Palleis and R. Perneczky and Jeffrey S. Phillips and Y. Pijnenburg and Deepti Putcha and N. Rahmouni and P. Rosa-Neto and James B. Rowe and M. Rullmann and O. Sabri and D. Saur and A. Schildan and J. Schott and M. Schroeter and S. Servaes and Irene Sintini and J. Stevenson and J. Therriault and Alexandra Touroutoglou and Anne E. Trainer and D. Visser and P. Weston and J. Whitwell and David A. Wolk and N. Franzmeier and R. Ossenkoppele},
  year = {2024},
  abstract = {There is a strong link between tau and progression of Alzheimer’s disease (AD), necessitating an understanding of tau spreading mechanisms. Prior research, predominantly in typical AD, suggested that tau propagates from epicenters (regions with earliest tau) to functionally connected regions. However, given the constrained spatial heterogeneity of tau in typical AD, validating this connectivity‐based tau spreading model in AD variants with distinct tau deposition patterns is crucial.},
  doi = {10.1002/alz.085869},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {20},
  altmetric = {true},
  dimensions = {true},
  note = {Cited by 1},
  pdf = {https://onlinelibrary.wiley.com/doi/pdfdirect/10.1002/alz.085869},
}

@article{chen2024subjectlevel,
  title = {Subject‐Level Segmentation Precision Weights for Volumetric Studies Involving Label Fusion},
  author = {Christina Chen and Sandhitsu R. Das and M. Tisdall and Fengling Hu and Andrew A. Chen and Paul Yushkevich and D. Wolk and Russell T. Shinohara},
  year = {2024},
  abstract = {In neuroimaging research, volumetric data contribute valuable information for understanding brain changes during both healthy aging and pathological processes. Extracting these measures from images requires segmenting the regions of interest (ROIs), and many popular methods accomplish this by fusing labels from multiple expert‐segmented images called atlases. However, post‐segmentation, current practices typically treat each subject's measurement equally without incorporating any information about variation in their segmentation precision. This naïve approach hinders comparing ROI volumes between different samples to identify associations between tissue volume and disease or phenotype. We propose a novel method that estimates the variance of the measured ROI volume for each subject due to the multi‐atlas segmentation procedure. We demonstrate in real data that weighting by these estimates markedly improves the power to detect a mean difference in hippocampal volume between controls and subjects with mild cognitive impairment or Alzheimer's disease.},
  doi = {10.1002/hbm.70082},
  pmid = {39697130},
  month = {12},
  journal = {Human Brain Mapping},
  volume = {45},
  altmetric = {true},
  dimensions = {true},
  pdf = {https://doi.org/10.1002/hbm.70082},
}

