@article{brown2024tau,
  title = {Tau Magnitude and eXent–Tau‐MaX: Capturing tau spread and local accumulation provides a robust metric of tau burden},
  author = {Christopher D. Brown and Sandhitsu R. Das and K. Cousins and T. Tropea and Alice Chen-Plotkin and Eddie B. Lee and I. Nasrallah and John A. Detre and Paul Yushkevich and Leslie M. Shaw and D. Wolk},
