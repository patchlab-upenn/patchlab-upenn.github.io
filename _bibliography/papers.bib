@article{arezoumandan2024automated,
  title = {Automated Neurofibrillary tangle detections in digital histopathology sections of the brain},
  author = {Sanaz Arezoumandan and Eric Teunissen‐Bermeo and N. Capp and Jamila Zablah and Daniel T. Ohm and Jeffrey S. Phillips and C. Mcmillan and Eddie B. Lee and David A. Wolk and Paul A. Yushkevich and David J. Irwin},
