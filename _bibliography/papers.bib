  year = {2026},
  abstract = {Parkinson's disease (PD) is characterized by predominantly neuronal α‐synuclein pathology and dopaminergic dysfunction. Cerebrospinal fluid (CSF) seeding amplification assays (SAA) detect α‐synuclein aggregates in vivo, but not all patients with PD have a positive SAA. This pathological heterogeneity among patients may not be entirely captured by binary results from α‐synuclein SAA positivity (S+) versus negativity (S–). To further dissect this biological variability, we explored spatial neuroimaging differences in S+ versus S– patients.},
