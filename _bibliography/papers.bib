@article{das2021application,
  title = {Application of histopathologically derived 3D tau burden map as in‐vivo region of interest for biomarker analysis},
  author = {Sandhitsu R. Das and Long Xie and R. de Flores and M. Muñoz and Maria Mercedes Iñiguez de Onzoño Martin and R. Ittyerah and Sydney A. Lim and S. Ravikumar and Madigan Lavery and S. Pickup and Weixia Liu and Jiancong Wang and Ling Yu Hung and Jade Lasserve and Nicolas Vergnet and M. Dong and Salena Cui and Lauren McCollum and J. Robinson and T. Schuck and M. Grossman and D. Tisdall and K. Prabhakaran and G. Mizsei and E. Artacho-Pérula and María del Mar Arroyo Jiménez and Maria del Pilar Marcos Rabal and Francisco Javier Molina Romero and Sandra Cebada Sanchez and José Carlos Delgado González and C. de la Rosa Prieto and Marta Córcoles Parada and Eddie B. Lee and J. Trojanowski and Daniel T. Ohm and I. Nasrallah and M. Kelley and J. Lane and M. Dicalogero and L. Wisse and D. Irwin and R. Insausti and Paul Yushkevich and D. Wolk},
  year = {2021},
  abstract = {Quantitative three‐dimensional maps of tau neurofibrillary tangles (NFT) burden derived from dense serial histology have potential application for in‐vivo biomarker studies. We constructed a group‐level NFT burden map from 15 medial temporal lobe (MTL) specimens, majority with Primary Age‐Related Tauopathy (PART) or low‐level Alzheimer’s disease neuropathologic change, and showed relatively greater NFT burden in the anterior vs. posterior MTL. We investigated whether in‐vivo MRI and PET measures in ROIs derived from this map show meaningful biological relationships.},
  doi = {10.1002/alz.055096},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {17},
  altmetric = {true},
  dimensions = {true},
  note = {Cited by 1},
}

