@article{hadar2020volumetric,
  title = {Volumetric glutamate imaging (GluCEST) using 7T MRI can lateralize nonlesional temporal lobe epilepsy: A preliminary study},
  author = {P. Hadar and Lohith G. Kini and R. Nanga and R. Shinohara and Stephanie H. Chen and Preya Shah and L. Wisse and M. Elliott and H. Hariharan and R. Reddy and J. Detre and J. Stein and Sandhitsu R. Das and K. Davis},
