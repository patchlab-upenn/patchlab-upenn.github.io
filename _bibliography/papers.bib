@article{mundada2024percentilebased,
  title = {Percentile‐based hippocampal volume MRI biomarker for distinguishing concomitant LATE and AD from pure LATE and pure AD},
  author = {Nidhi S Mundada and Xueying Lyu and E. McGrew and Long Xie and Paul Yushkevich and Sandhitsu R. Das and D. Wolk},
  year = {2024},
  abstract = {Due to the lack of in vivo molecular biomarkers for Limbic‐predominant age‐related TDP‐43 encephalopathy (LATE), which commonly co‐occurs with Alzheimer’s disease (AD), it is challenging to identify patients with mixed AD/LATE pathology. Autopsy studies have suggested that AD patients with greater hippocampal atrophy are disproportionately enriched in having concomitant LATE. Here we define the lower quartile of hippocampal volume as a biomarker of possible LATE with AD.},
