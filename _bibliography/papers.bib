@article{ravikumar2022combining,
  title = {Combining high‐resolution ex vivo MRI and histopathology to identify medial temporal lobe atrophy patterns specific to tau pathology in Alzheimer’s Disease},
  author = {S. Ravikumar and Amanda E Denning and Sydney A. Lim and E. Chung and R. Ittyerah and L. Wisse and Long Xie and Sandhitsu R. Das and J. Robinson and T. Schuck and M. Grossman and Eddie B. Lee and D. Tisdall and G. Mizsei and E. Artacho-Pérula and Maria Mercedes Iniguez de Onzono Martin and María del Mar Arroyo Jiménez and M. Muñoz and Francisco Javier Molina Romero and P. M. Rabal and Sandra Cebada Sanchez and José Carlos Delgado González and Rosa Prieto and Marta Córcoles Parada and D. Irwin and J. Trojanowski and D. Wolk and R. Insausti and Paul Yushkevich},
  year = {2022},
  abstract = {Tau pathology in the medial temporal lobe (MTL) is closely linked to neurodegeneration, and is an early pathological change associated with Alzheimer’s disease (AD). MRI measures of MTL neurodegeneration have proven to be sensitive to change during preclinical AD. Current measures are confounded by the presence of non‐AD pathologies (e.g., TDP‐43, ageing). Here, we combine ex vivo imaging with histopathological ratings of tau and TDP‐43 to identify fine‐grained MTL atrophy patterns specific to tau. Such an analysis could be used to define MTL “hotspots” where in vivo measures of neurodegeneration are expected to be strongly associated with tau, potentially enabling the development of biomarkers that are more effective during early AD clinical trials.},
  doi = {10.1002/alz.065784},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {18},
  altmetric = {true},
  dimensions = {true},
  pdf = {https://doi.org/10.1002/alz.065784},
}

