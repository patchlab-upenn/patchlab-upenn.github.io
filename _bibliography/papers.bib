@article{vogel2023effects,
  title = {Effects of Alzheimer’s disease genetic risk on brain morphometric development in three multiple‐ancestry pediatric datasets},
  author = {Jacob W. Vogel and Laura M. Schultz and Bart Larsen and Jakob Seidlitz and Noor B. Al-Sharif and R. Barzilay and M. Cieslak and S. Covitz and Raquel E. Gur and Ruben C. Gur and Guillaume Huguet and Renaud La Joie and C. Mcmillan and Nathalie I.V. Nilsson and J. Poline and K. Ruparel and R. T. Shinohara and Laura EM Wisse and Daniel H. Wolf and David A. Wolk and A. Alexander-Bloch and L. Almasy and Theodore Satterthwaite},
  year = {2023},
