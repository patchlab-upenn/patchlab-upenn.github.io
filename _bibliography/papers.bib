  year = {2025},
  abstract = {Tau burden consists of both spatial spread and local accumulation, but no study has combined these measures into a single metric to capture overall global tau burden. Here we investigate a new measure combining magnitude and extent—Tau‐MaX—as a marker of Alzheimer's disease (AD) severity.},
