@article{cousins2024combining,
  title = {Combining plasma biomarkers for β‐amyloid diagnosis and cognitive prognosis across the clinical spectrum: normal, amnestic, and non‐amnestic},
  author = {K. Cousins and J. Phillips and Sandhitsu R. Das and Kyra S O'Brien and T. Tropea and Alice Chen-Plotkin and Leslie M. Shaw and I. Nasrallah and Dawn Mechanic-Hamilton and C. Mcmillan and David J. Irwin and Eddie B. Lee and D. Wolk},
  year = {2024},
  abstract = {Alzheimer’s disease (AD) is clinically heterogeneous, and can manifest as amnestic or non‐amnestic dementia, or be pre‐manifest in persons with normal cognition (NormCog). Utility of plasma biomarkers to diagnose AD and prognose cognitive decline must be evaluated in a clinically heterogeneous population representative of the AD spectrum. We investigate pathological and cognitive correlates of plasma phosphorylated tau 181 (p‐tau181), glial fibrillary acidic protein (GFAP), and neurofilament light chain (NfL) across AD and AD‐related dementias (ADRD). We test 1.) if combing biomarkers improves diagnostic accuracy for β‐amyloid (Aβ) in NormCog and impaired cognition (ImpCog), 2.) if Aβ diagnostic accuracy in ImpCog differs by clinical syndrome (amnestic dementia vs. non‐amnestic dementia vs. mild cognitive impairment [MCI]), and 3.) how biomarkers predict future cognitive decline in Aβ+ and Aβ‐.},
  doi = {10.1002/alz.085075},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {20},
  altmetric = {true},
  dimensions = {true},
  pdf = {https://doi.org/10.1002/alz.085075},
}

@article{denning2024association,
  title = {Association of quantitative measurements of postmortem tau tangle and thread pathology with antemortem cortical thickness measurements in neuropathologically confirmed Alzheimer’s Disease continuum patients},
  author = {Amanda E Denning and R. Ittyerah and Niyousha Sadeghpour and Lisa Levorse and E. Chung and Chinmayee Athalye and S. Ravikumar and M. Dong and M. Duong and Yue Li and Ademola Ilesanmi and S. Hrybouski and Lasya P. Sreepada and Philip Sabatini and MaKayla Lowe and A. Bahena and Ryohei Watanabe and Boram Kim and R. de Flores and J. Robinson and T. Schuck and Daniel T. Ohm and Sanaz Arezoumandan and R. Insausti and L. Wisse and David J. Irwin and Eddie B. Lee and Sandhitsu R. Das and D. Wolk and Paul Yushkevich},
  year = {2024},
  abstract = {Tau pathology and neurodegeneration in the medial temporal lobe (MTL) are highly associated in Alzheimer’s Disease (AD). However, the spatial pattern of neurodegeneration, contribution of individual tau inclusion types, and influence of MTL co‐pathologies (i.e., TDP‐43) remain poorly understood. Traditional semi‐quantitative ratings or staging schemes of tau pathology capture limited variability in severity and provide no differentiation between inclusion types (i.e., tangles, threads). We correlate semi‐quantitative and quantitative measures of MTL tau pathology from postmortem tissue samples with MTL cortical thickness measures from antemortem MRI.},
  doi = {10.1002/alz.087360},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {20},
  altmetric = {true},
  dimensions = {true},
}

@article{denning2024mapping,
  title = {Mapping Anatomical Boundaries from Histology to Antemortem MRI to Inform Automatic Segmentation of Medial Temporal Lobe Subregions},
  author = {Amanda E Denning and Sydney A. Lim and Yue Li and Niyousha Sadeghpour and S. Ravikumar and R. Ittyerah and E. Chung and M. Bedard and K. Prabhakaran and W. Trotman and A. Bahena and Daniel T. Ohm and J. Robinson and T. Schuck and D. Tisdall and E. Artacho-Pérula and Maria Mercedes Iñiguez de Onzoño Martin and M. Muñoz and Francisco Javier Molina Romero and José Carlos Delgado González and María del Mar Arroyo Jiménez and M. Rabal and Sandra Cebada Sanchez and Carlos de la Rosa Prieto and Marta Córcoles Parada and David J. Irwin and Eddie B. Lee and Sandhitsu R. Das and D. Wolk and Paul Yushkevich and R. Insausti and L. Wisse},
  year = {2024},
  abstract = {The medial temporal lobe (MTL) is the epicenter of both primary and concomitant molecular pathologies in Alzheimer’s disease (AD). The intricate anatomy of the MTL has been the subject of extensive study over the past two centuries. However, current PET and MRI AD biomarkers use often crude parcellations of the MTL that have not been sufficiently validated vis‐à‐vis anatomical ground truth. Here we use a unique dataset of finely annotated serial histology, ex vivo MRI and antemortem 3T in vivo MRI of the MTL from 17 brain donors to train and evaluate an automatic MTL subregion segmentation algorithm. To our knowledge, this is the most comprehensive attempt to infuse MRI biomarkers with cytoarchitectural reference annotations.},
  doi = {10.1002/alz.091831},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {20},
  altmetric = {true},
  dimensions = {true},
}

@article{emrani2024patterns,
  title = {Patterns of iron‐rich gliosis in FTLD‐TDP versus FTLD‐Tau},
  author = {Sheina Emrani and Sanaz Arezoumandan and Katheryn A. Q. Cousins and N. Capp and Eddie B. Lee and David A. Wolk and Paul A. Yushkevich and C. Mcmillan and M. Dylan Tisdall and David J. Irwin},
  year = {2024},
  abstract = {We recently found region‐specific patterns of iron‐rich gliosis in frontotemporal lobar degeneration (FTLD) groups with tau (FTLD‐Tau; PSP) and TDP‐43 (FTLD‐TDP) pathology using iron‐sensitive MRI of whole‐hemispheres. These patterns largely corresponded to regions of early pathology reported in previous traditional histopathologic staging schemes of protein inclusions for FTLD‐Tau and FTLD‐TDP. Ferritin light chain (FLC) reactivity highlights activated glia but has not been studied extensively in FTLD. We hypothesize neuroinflammation marked by FLC‐reactive glia may relate to protein aggregation and contribute to partially distinct regional patterns of Tau vs TDP‐43 propagation in FTLD.},
  doi = {10.1002/alz.092610},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {20},
  altmetric = {true},
  dimensions = {true},
  pdf = {https://doi.org/10.1002/alz.092610},
}

@article{flores2024multiatlas,
  title = {Multi‐atlas fully automated segmentation of the locus coeruleus in in vivo neuromelanin‐sensitive MRI},
  author = {R. de Flores and T. Blanchard and E. Foyard and M. Naveau and N. Delcroix and B. Landeau and Paul Yushkevich and G. Chételat},
  year = {2024},
  abstract = {Locus coeruleus (LC) imaging using neuromelanin‐sensitive (NM) MRI sequences is a promising biomarker for detecting early Alzheimer’s Disease (AD). Although automatic approaches have been developed to estimate LC integrity by measuring its intensity, these techniques most often rely on a single template built in a standardized space and/or depend on a number of voxels to be accounted that is defined a priori. Thus, these algorithms make it impossible to perform direct volumetric analyses and do not properly account for inter‐individual anatomical variability. To fill this gap, our aim was to develop a new multi‐atlas fully automated segmentation method using the Automatic Segmentation of Hippocampal Subfields (ASHS) software.},
  doi = {10.1002/alz.088688},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {20},
  altmetric = {true},
  dimensions = {true},
  note = {Cited by 1},
}

@article{hrybouski2024bold,
  title = {BOLD fMRI signal changes in preclinical Alzheimer’s disease},
  author = {S. Hrybouski and Sandhitsu R. Das and Long Xie and Xueying Lyu and L. Wisse and M. Kelley and J. Lane and Monica Sherin and M. Dicalogero and I. Nasrallah and John A. Detre and Paul Yushkevich and D. Wolk},
  year = {2024},
  abstract = {Previous work suggests functional abnormalities in the human brain in preclinical Alzheimer’s disease. However, little has been explored about the relationship between BOLD fMRI signal amplitude/energy over time and AD pathology. In this work we analyzed the effects of AD progression on amplitude of low‐frequency fluctuations (ALFF) during resting‐state fMRI scans both at the whole‐brain level and at a more granular level, focused on regions of the medial temporal lobe (MTL) that are most vulnerable to AD pathology.},
  doi = {10.1002/alz.094155},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {20},
  altmetric = {true},
  dimensions = {true},
  note = {Cited by 2},
  pdf = {https://doi.org/10.1002/alz.094155},
}

@article{hrybouski2024mtl,
  title = {MTL networks are differentially affected by tau pathology},
  author = {S. Hrybouski and Sandhitsu R. Das and Long Xie and L. Wisse and M. Kelley and J. Lane and Monica Sherin and M. Dicalogero and I. Nasrallah and John A. Detre and Paul Yushkevich and D. Wolk},
  year = {2024},
  abstract = {The extent to which pathological processes in aging and Alzheimer’s disease (AD) relate to functional alterations in the medial temporal lobe (MTL)‐dependent brain networks is poorly understood. Here, we examined the relationship between tau accumulation in the (trans)entorhinal cortex and functional connectivity (FC) in two MTL‐affiliated brain networks — the Anterior‐Temporal (AT) and Posterior‐Medial (PM) — in normal agers, individuals with preclinical AD, and patients with symptomatic AD.},
  doi = {10.1002/alz.092666},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {20},
  altmetric = {true},
  dimensions = {true},
  pdf = {https://doi.org/10.1002/alz.092666},
}

@article{ilesanmi2024diffuse,
  title = {Diffuse juxtacortical white matter texture changes in pre‐clinical Alzheimer’s disease},
  author = {Ademola Ilesanmi and Xueying Lyu and E. McGrew and Paul Yushkevich and Sandhitsu R. Das and D. Wolk},
  year = {2024},
  abstract = {Detection of neurodegeneration during preclinical stages of Alzheimer’s disease (AD) is critical for disease prediction and monitoring. Macrostructural brain changes (volume/thickness) during preclinical AD are often not detectable in cross‐sectional studies. Microstructural changes manifested as alterations in texture features may capture subtle neurodegeneration at this stage. Here we investigated the discriminative ability of texture‐based radiomics features in both gray and juxtacortical white matter in preclinical AD.},
  doi = {10.1002/alz.094122},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {20},
  altmetric = {true},
  dimensions = {true},
  pdf = {https://doi.org/10.1002/alz.094122},
}

@article{khandelwal2024highresolution,
  title = {High‐resolution 7 tesla postmortem MRI for quantitative analysis of structure‐pathology correlations in neurodegenerative diseases},
  author = {Pulkit Khandelwal and M. Duong and S. Sadaghiani and Sydney A. Lim and Amanda E Denning and E. Chung and S. Ravikumar and Sanaz Arezoumandan and Claire S. Peterson and M. Bedard and N. Capp and R. Ittyerah and Elyse Migdal and Grace Choi and Emily Kopp and Bridget Loja Patino and Eusha Hasan and Jiacheng Li and A. Bahena and K. Prabhakaran and G. Mizsei and M. Gabrielyan and T. Schuck and W. Trotman and J. Robinson and Daniel T. Ohm and Eddie B. Lee and J. Trojanowski and C. Mcmillan and Murray Grossman and David J. Irwin and John A. Detre and D. Tisdall and Sandhitsu R. Das and L. Wisse and D. Wolk and Paul Yushkevich},
  year = {2024},
  abstract = {Postmortem MRI allows brain anatomy to be examined at high‐resolution linking pathology with morphometric measurements. However, automated methods for analyzing postmortem MRI are not well developed. We present a deep learning‐based framework for automated segmentation of cortical mantle, subcortical structures (caudate, putamen, globus pallidus, and thalamus), white matter hyperintensities (WMH), and normal appearing white matter in (n = 135) postmortem human brain tissue specimens (Table 1) imaged at 0.3 mm3 T2w 7T spanning Alzheimer’s disease and related dementias. We show generalizing capabilities across unseen images acquired at 0.28 mm3 and 0.16 mm3 T2*w 7T FLASH sequence. We report associations between localized cortical thickness and volumetric measurements across key regions and semi‐quantitative neuropathological ratings.},
  doi = {10.1002/alz.093987},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {20},
  altmetric = {true},
  dimensions = {true},
  pdf = {https://doi.org/10.1002/alz.093987},
}

@article{li2024robust,
  title = {Robust multi‐modality segmentation of medial temporal lobe subregions using both 3‐tesla and 7‐tesla magnetic resonance imaging},
  author = {Yue Li and Pulkit Khandelwal and Long Xie and Christopher D. Brown and Xueying Lyu and Amanda E Denning and M. Dong and Sandhitsu R. Das and D. Wolk and Paul Yushkevich},
  year = {2024},
  abstract = {Volumetry of subregions in the medial temporal lobe (MTL) computed from automatic segmentation in MRI can track neurodegeneration in Alzheimer’s disease. However, dropout artifacts are present in some modalities, leading to poor image quality and unreliable segmentation of MTL subregions. Considering that MRI modalities with different field strength offer distinct advantages in imaging different parts of the MTL, we developed a muti‐modality segmentation model using both 7‐tesla (7T) and 3‐tesla (3T) structural MRI to obtain robust segmentation in poor‐quality images.},
  doi = {10.1002/alz.092878},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {20},
  altmetric = {true},
  dimensions = {true},
  pdf = {https://doi.org/10.1002/alz.092878},
}

@article{lyu2024eventbased,
  title = {Event‐based modeling of T‐N mismatch reveals distinct spatio‐temporal trajectories of subtypes with likely co‐pathology in Alzheimer’s disease},
  author = {Xueying Lyu and Paul Yushkevich and S. Hrybouski and Yue Li and M. Duong and Long Xie and L. Wisse and R. de Flores and David J. Irwin and B. Dickerson and I. Nasrallah and Sandhitsu R. Das and D. Wolk},
  year = {2024},
  abstract = {The heterogeneity of Alzheimer’s disease (AD) and lack of well‐validated markers of co‐pathologies present a substantial challenge for therapeutics. We previously found phenotypes defined by Tau (T) ‐ Neurodegeneration (N) discordance linked to non‐Alzheimer’s pathologies (e.g. TDP‐43, vascular disease). In this work, we aim to leverage T‐N mismatch for identifying distinct spatial‐temporal progression patterns of non‐AD pathologies.},
  doi = {10.1002/alz.092442},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {20},
  altmetric = {true},
  dimensions = {true},
