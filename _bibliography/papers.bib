@article{lyu2023tauneurodegeneration2,
  title = {tau‐neurodegeneration mismatch from inter‐modality image translation using deep learning},
  author = {Xueying Lyu and Pulkit Khandelwal and M. Duong and Jiancong Wang and Long Xie and L. Wisse and Paul Yushkevich and Sandhitsu R. Das and D. Wolk},
  year = {2023},
  abstract = {The relationship between tau neurofibrillary tangles (T) and neurodegeneration (N) may offer clues to potential presence of comorbidities, as well as relative resilience and vulnerability to Alzheimer’s disease (AD) pathology. We have previously developed measures of tau PET (T) and cortical thickness (N) mismatch based on linear model residuals. However, the underlying relationships between T and N are likely complex and non‐linear. Moreover, predicting cortical thickness based on local tau level may miss non‐local contributions of tauopathy. Here we investigate T‐N mismatch using a deep‐learning 3D image translation neural network to estimate synthetic maps of cortical thickness based on tau PET images. Deviation between the synthetic and actual cortical thickness serves as a metric of T‐N mismatch.},
  doi = {10.1002/alz.080166},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {19},
  altmetric = {true},
  dimensions = {true},
  note = {Cited by 1},
  pdf = {https://onlinelibrary.wiley.com/doi/pdfdirect/10.1002/alz.080166},
}

@article{mechanichamilton2023remote,
  title = {Remote App‐Based Assessment of Memory and Executive Functioning in Aging and Pre‐Clinical Alzheimer’s Disease in a Diverse Sample of Older Adults},
  author = {Dawn Mechanic-Hamilton and Kimberly Halberstadter and Rachel Rovere and Erin Liebenberg and David A. Wolk},
