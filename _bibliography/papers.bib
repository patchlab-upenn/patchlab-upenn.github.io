  author = {Pulkit Khandelwal and S. Sadaghiani and S. Ravikumar and Sydney A. Lim and Sanaz Arezoumandan and Claire S. Peterson and E. Chung and M. Bedard and N. Capp and R. Ittyerah and Elyse Migdal and G. Choi and Emily Kopp and Bridget Loja and Eusha Hasan and Jiacheng Li and K. Prabhakaran and G. Mizsei and M. Gabrielyan and T. Schuck and J. Robinson and Daniel T. Ohm and Eddie B. Lee and J. Trojanowski and C. Mcmillan and M. Grossman and D. Irwin and M. Tisdall and Sandhitsu R. Das and L. Wisse and D. Wolk and Paul Yushkevich},
  year = {2021},
  abstract = {Ex vivo MRI of the brain provides remarkable advantages over in vivo MRI for visualizing and characterizing detailed neuroanatomy. However, automated cortical segmentation methods in ex vivo MRI are not well developed, primarily due to limited availability of labeled datasets, and heterogeneity in scanner hardware and acquisition protocols. In this work, we present a high resolution 7 Tesla dataset of 32 ex vivo human brain specimens. We benchmark the cortical mantle segmentation performance of nine neural network architectures, trained and evaluated using manually-segmented 3D patches sampled from specific cortical regions, and show excellent generalizing capabilities across whole brain hemispheres in different specimens, and also on unseen images acquired at different magnetic field strength and imaging sequences. Finally, we provide cortical thickness measurements across key regions in 3D ex vivo human brain images. Our code and processed datasets are publicly available at https://github.com/Pulkit-Khandelwal/picsl-ex-vivo-segmentation.},
  arxiv = {2110.07711},
  month = {10},
  journal = {ArXiv},
  volume = {abs/2110.07711},
  altmetric = {true},
  dimensions = {true},
  note = {Cited by 4},
}

@article{ravikumar2021ex,
  title = {Ex vivo MRI atlas of the human medial temporal lobe: characterizing neurodegeneration due to tau pathology},
  author = {S. Ravikumar and L. Wisse and Sydney A. Lim and R. Ittyerah and Long Xie and M. Bedard and Sandhitsu R. Das and Eddie B. Lee and M. Tisdall and K. Prabhakaran and J. Lane and J. Detre and G. Mizsei and J. Trojanowski and J. Robinson and T. Schuck and M. Grossman and E. Artacho-Pérula and Maria Mercedes Iñiguez de Onzoño Martin and María del Mar Arroyo Jiménez and M. Muñoz and Francisco Javier Molina Romero and Maria del Pilar Marcos Rabal and Sandra Cebada Sanchez and José Carlos Delgado González and C. de la Rosa Prieto and Marta Córcoles Parada and D. Irwin and D. Wolk and R. Insausti and Paul Yushkevich},
  year = {2021},
  abstract = {Tau neurofibrillary tangle (NFT) pathology in the medial temporal lobe (MTL) is closely linked to neurodegeneration, and is the early pathological change associated with Alzheimer’s disease (AD). To elucidate patterns of structural change in the MTL specifically associated with tau pathology, we compared high-resolution ex vivo MRI scans of human postmortem MTL specimens with histology-based pathological assessments of the MTL. MTL specimens were obtained from twenty-nine brain donors, including patients with AD, other dementias, and individuals with no known history of neurological disease. Ex vivo MRI scans were combined using a customized groupwise diffeomorphic registration approach to construct a 3D probabilistic atlas that captures the anatomical variability of the MTL. Using serial histology imaging in eleven specimens, we labelled the MTL subregions in the atlas based on cytoarchitecture. Leveraging the atlas and neuropathological ratings of tau and TAR DNA-binding protein 43 (TDP-43) pathology severity, morphometric analysis was performed to correlate regional MTL thickness with the severity of tau pathology, after correcting for age and TDP-43 pathology. We found significant correlations between tau pathology and thickness in the entorhinal cortex (ERC) and stratum radiatum lacunosum moleculare (SRLM). When focusing on cases with low levels of TDP-43 pathology, we found strong associations between tau pathology and thickness in the ERC, SRLM and the subiculum/cornu ammonis 1 (CA1) subfields of the hippocampus, consistent with early Braak stages.},
  doi = {10.1186/s40478-021-01275-7},
  pmid = {34689831},
  month = {10},
  journal = {Acta Neuropathologica Communications},
  volume = {9},
  altmetric = {true},
  dimensions = {true},
  note = {Cited by 48},
  pdf = {https://link.springer.com/content/pdf/10.1186/s40478-021-01275-7.pdf},
}

