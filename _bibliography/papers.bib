  author = {J. Hanson and J. Suh and Brendon M. Nacewicz and Matthew J. Sutterer and Amelia A. Cayo and Diane E. Stodola and Cory A. Burghy and Hongzhi Wang and B. Avants and Paul Yushkevich and M. Essex and S. Pollak and R. Davidson},
