  author = {Jesse S Cohen and Jeffrey Phillips and Sandhitsu R. Das and Christopher A. Olm and Hamsanandini Radhakrishnan and Emma Rhodes and K. Cousins and S. Xie and Ilya M. Nasrallah and Paul Yushkevich and D. Wolk and Edward B. Lee and Daniel Weintraub and D. Irwin and C. Mcmillan},
  year = {2024},
  abstract = {Highlights • LBD/AD+ shows a subregion-specific pattern of medial temporal lobe atrophy.• Atrophy severity largely follows expectations from Braak tau stages.• However, posterior hippocampus is spared, deviating from Braak.• Radiopathologic correlation is consistent with tau-dependent neurodegeneration.• MRI in LBD/AD+ could help stratify individuals for therapy trials.},
  doi = {10.1016/j.nicl.2024.103714},
