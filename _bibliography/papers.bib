  author = {N. S. Mundada and X. Lyu and N. Sadeghpour and Christopher D. Brown and E. McGrew and L. Xie and Paul Yushkevich and Sandhitsu R Das and David A. Wolk},
  year = {2025},
  abstract = {Overlap in clinical presentations, absence of well‐validated in‐vivo biomarkers for Limbic‐predominant age‐related TDP‐43 encephalopathy (LATE), and frequent co‐occurrence with AD, complicates identifying mixed AD/LATE cases. Autopsy studies suggest greater hippocampal atrophy in AD patients with concomitant LATE. We aimed to identify patients along the AD continuum enriched for LATE by defining the lower quartile of hippocampal volume (HV) as a biomarker for possible LATE and explore atrophy patterns and cognitive profiles.},
  doi = {10.1002/alz70862_110000},
  pmid = {41433732},
  month = {12},
  journal = {Alzheimer's & Dementia},
  volume = {21},
  altmetric = {true},
  dimensions = {true},
}

@article{phillips2025associations,
