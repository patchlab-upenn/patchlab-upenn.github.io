  author = {A. Pouch and M. Vergnat and Jeremy R. McGarvey and G. Ferrari and B. Jackson and C. Sehgal and Paul Yushkevich and R. Gorman and J. Gorman},
  year = {2014},
  doi = {10.1016/j.athoracsur.2013.07.096},
